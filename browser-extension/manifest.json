{
  "manifest_version": 3,
  "name": "Construct 2 AI Bridge — Browser Connector",
  "version": "0.4.0",
  "description": "User-controlled Construct 2 project context and supervised collaboration with ChatGPT, Claude, and Gemini.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "action": {
    "default_title": "Construct 2 AI Bridge",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "construct2-ai-bridge@innygr.local",
      "strict_min_version": "121.0"
    }
  }
}
